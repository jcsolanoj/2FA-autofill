{
  "manifest_version": 3,
  "name": "2FA Autofill",
  "version": "2.0.0",
  "description": "Autenticador 2FA/TOTP multi-empresa sin dependencias externas con autocompletado por dominio autorizado.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "2FA Autofill"
  }
}
